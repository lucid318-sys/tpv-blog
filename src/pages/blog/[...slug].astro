    flex-shrink: 0;
  }
  .pf-cta-btn:hover { opacity: 0.85; }

  /* ── Back ── */
  .back-area {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    text-align: center;
  }
  .back {
    font-size: 0.9rem;
    font-weight: 600;
    color: #D4622B;
