---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { TAX_INFO } from "../../data/taxinfo";

const categoryLabels: Record<string, string> = {
  chwideuk: "취득세",
  yangdo: "양도세",
  jeungyeo: "증여세",
  sangsok: "상속세",
  etc: "기타",
};

const typeLabels: Record<string, string> = {
  column: "칼럼",
  case: "사례",
  "해설": "해설",
};

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const sorted = allPosts.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return sorted.map((post) => {
    const sameCat = sorted.filter(
      (p) => p.id !== post.id && p.data.category === post.data.category
    );
    const related =
      sameCat.length > 0
        ? sameCat.slice(0, 3)
        : sorted.filter((p) => p.id !== post.id).slice(0, 3);

    return {
      params: { slug: post.id },
      props: { post, relatedPosts: related },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);
const catLabel = categoryLabels[post.data.category] ?? post.data.category;
const typeLabel = post.data.type ? (typeLabels[post.data.type] ?? post.data.type) : null;
const taxInfo = TAX_INFO[post.data.category];

const SIDEBAR_LINK_DEFS = [
  {
    label: "조정대상지역 검색",
    href: "/resources/regulated-areas/",
    match: (cat: string, tags: string[]) =>
      cat === "yangdo" || cat === "chwideuk" ||
      tags.some((t) => ["중과", "중과세율", "다주택자", "1세대1주택", "비과세", "조정대상지역", "임대주택"].includes(t)),
  },
  {
    label: "서식·자료 모음",
    href: "/resources/",
    match: (cat: string, tags: string[]) =>
      cat === "jeungyeo" || cat === "sangsok" ||
      tags.some((t) => ["증여세신고", "자녀증여", "차용증", "상속세신고"].includes(t)),
  },
];

const postTags = post.data.tags ?? [];
const sidebarLinks = SIDEBAR_LINK_DEFS.filter((l) => l.match(post.data.category, postTags));
---
<Base title={post.data.title}>
  <!-- A. 글 헤더 — 다크 띠 -->
  <header class="post-header">
    <div class="post-header-line" aria-hidden="true"></div>
    <div class="post-header-inner">
      <div class="post-meta-top">
        <span class="meta-cat">{catLabel}</span>
        {typeLabel && <><span class="meta-sep">·</span><span class="meta-type">{typeLabel}</span></>}
        <span class="meta-sep">·</span>
        <time class="meta-date">{post.data.date}</time>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta-bottom">
        {post.data.basis && (
          <span class="meta-basis">기준 <span class="meta-mono">{post.data.basis}</span></span>
        )}
        {post.data.basis && post.data.status && <span class="meta-sep">·</span>}
        {post.data.status && <span class="meta-status">{post.data.status}</span>}
        {(post.data.basis || post.data.status) && post.data.tags && post.data.tags.length > 0 && (
          <span class="meta-sep">|</span>
        )}
        {post.data.tags && post.data.tags.length > 0 && (
          <span class="meta-tags">
            {post.data.tags.map((tag: string, i: number) => (
              <><a href={`/tags/${tag}/`} class="meta-tag"># {tag}</a>{i < post.data.tags!.length - 1 && " "}</>
            ))}
          </span>
        )}
      </div>
    </div>
  </header>

  <main class="layout">
    <article class="article">
      <!-- B. "한 줄로" 요약 블록 -->
      {post.data.summary && (
        <div class="summary-block">
          <p class="summary-label">한 줄로</p>
          <p class="summary-text">{post.data.summary}</p>
        </div>
      )}

      <div class="body">
        <Content />
      </div>
    </article>

    <aside class="sidebar">
      <form class="sidebar-search" action="/search/" method="get">
        <p class="sidebar-title">키워드로 찾기</p>
        <div class="search-input-wrap">
          <input type="text" name="q" placeholder="검색어 입력" class="search-input" />
          <button type="submit" class="search-btn" aria-label="검색">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </div>
      </form>

      {taxInfo && (
        <div class="sidebar-taxinfo">
          <p class="sidebar-title">{catLabel} 한눈에</p>
          <table class="si-table">
            <thead><tr><th>과세표준</th><th>세율</th><th>누진공제</th></tr></thead>
            <tbody>
              {taxInfo.rates.map((r) => (
                <tr><td>{r.bracket}</td><td>{r.rate}</td><td>{r.deduction}</td></tr>
              ))}
            </tbody>
          </table>

          <p class="si-sub">증여재산공제 (10년간)</p>
          <table class="si-table">
            <thead><tr><th>증여자</th><th>공제한도</th></tr></thead>
            <tbody>
              {taxInfo.exemptions.map((e) => (
                <tr><td>{e.relation}</td><td>{e.limit}</td></tr>
              ))}
            </tbody>
          </table>
          {taxInfo.exemptionNote && <p class="si-note">{taxInfo.exemptionNote}</p>}

          <div class="si-footer">
            <p>신고기한: {taxInfo.filingDeadline}</p>
            <p>신고·납부: {taxInfo.filingPerson}</p>
          </div>
        </div>
      )}

      {sidebarLinks.length > 0 && (
        <div class="sidebar-links">
          <p class="sidebar-title">관련 링크</p>
          <ul>
            {sidebarLinks.map((link) => (
              <li><a href={link.href}>{link.label} &rarr;</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="sidebar-cta">
        <p class="cta-label">상담이 필요하세요?</p>
        <a href="https://pf.kakao.com/_dcihX/chat" target="_blank" rel="noopener" class="cta-btn">
          카카오톡 상담
        </a>
      </div>
    </aside>
  </main>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <div class="related-posts-inner">
        <p class="related-posts-title">같이 읽으면 좋은 글</p>
        <ul class="related-posts-list">
          {relatedPosts.map((rp: any) => (
            <li>
              <a href={`/blog/${rp.id}/`}>
                <span class="rp-cat">{categoryLabels[rp.data.category]}</span>
                <span class="rp-title">{rp.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- G. 글 하단 — 다크 CTA 띠 -->
  <footer class="post-footer">
    <div class="post-footer-inner">
      <div class="pf-cta">
        <div class="pf-cta-text">
          <p class="pf-cta-title">여기까지는 일반론입니다.</p>
          <p class="pf-cta-desc">내 경우는 다를 수 있습니다 — 상황을 알려주시면 정리해 드릴게요.</p>
        </div>
        <a href="https://pf.kakao.com/_dcihX/chat" target="_blank" rel="noopener" class="pf-cta-btn">
          카카오톡 상담하기
        </a>
      </div>
    </div>
  </footer>

  <div class="back-area">
    <a href="/" class="back">&larr; 목록으로</a>
  </div>
</Base>

<style>
  /* ── A. Post Header — Dark Strip ── */
  .post-header {
    background-color: #2C2117;
    background-image:
      linear-gradient(rgba(245,240,232,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245,240,232,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    position: relative;
    padding: 2.5rem 1.5rem 2rem;
  }
  .post-header-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: rgba(212,98,43,0.4);
  }
  .post-header-inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .meta-cat {
    color: #D4622B;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
  .meta-type {
    color: #b5a894;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .meta-sep {
    color: #5a4e40;
    font-size: 0.75rem;
  }
  .meta-date {
    color: #b5a894;
    font-size: 0.8rem;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }
  .post-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 2.125rem;
    font-weight: 800;
    color: #F5F0E8;
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .post-meta-bottom {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .meta-basis,
  .meta-status {
    color: #b5a894;
    font-size: 0.75rem;
  }
  .meta-mono {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }
  .meta-tags {
    font-size: 0.75rem;
  }
  .meta-tag {
    color: #8a7e6f;
    transition: color 0.15s;
  }
  .meta-tag:hover {
    color: #D4622B;
  }

  /* ── Layout ── */
  .layout {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    overflow-x: hidden;
  }

  /* ── Article ── */
  .article {
    flex: 1;
    min-width: 0;
    max-width: 100%;
  }

  /* ── B. Summary Block ── */
  .summary-block {
    border-top: 2px solid #D4622B;
    padding-top: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .summary-label {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #D4622B;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .summary-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #3a3229;
  }

  /* ── C. Body Typography ── */
  .body {
    font-size: 0.9375rem;
    line-height: 1.85;
    color: #3a3229;
    counter-reset: h2counter;
  }
  .body :global(h2) {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 1.1875rem;
    font-weight: 800;
    color: var(--dark-brown);
    margin: 3rem 0 0.75rem;
    padding: 0 0 0.5rem;
    border-bottom: 1px solid #EAE4D8;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    counter-increment: h2counter;
    background: none;
    border-left: none;
    border-radius: 0;
  }
  .body :global(h2)::before {
    content: counter(h2counter, decimal-leading-zero);
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #D4622B;
    flex-shrink: 0;
    background: none;
    min-width: auto;
    height: auto;
    border-radius: 0;
    display: inline;
    align-items: initial;
    justify-content: initial;
    margin-top: 0;
  }
  .body :global(h3) {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--dark-brown);
    margin: 2.5rem 0 0.75rem;
    padding: 0;
    background: none;
    border-left: none;
    border-radius: 0;
  }
  .body :global(p) {
    margin-bottom: 1.25rem;
  }
  .body :global(ul), .body :global(ol) {
    margin: 0.5rem 0 1.25rem 1.25rem;
  }
  .body :global(li) {
    margin-bottom: 0.4rem;
  }
  .body :global(strong) {
    color: var(--dark-brown);
    font-weight: 700;
  }
  .body :global(a) {
    color: #D4622B;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .body :global(a:hover) {
    opacity: 0.8;
  }
  .body :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-weight: 700;
    color: var(--dark-brown);
    font-size: 0.9em;
    background: none;
    padding: 0;
  }
  .body :global(hr) {
    border: none;
    height: 1px;
    background: #EAE4D8;
    margin: 2.5rem 0;
  }

  /* ── D. Table ── */
  .body :global(.table-wrap) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.25rem 0;
    border-radius: 8px;
    border: 1px solid #EAE4D8;
    max-width: 100%;
  }
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .body :global(th) {
    background: #EAE4D8;
    color: var(--dark-brown);
    font-weight: 700;
    padding: 0.65rem 1rem;
    text-align: left;
    white-space: nowrap;
  }
  .body :global(td) {
    padding: 0.6rem 1rem;
    border-top: 1px solid #EAE4D8;
  }
  .body :global(tr:nth-child(even) td) {
    background: #faf8f4;
  }
  .body :global(.table-footnote) {
    font-size: 0.71875rem;
    color: #999;
    margin-top: 0.35rem;
    margin-bottom: 1.25rem;
  }

  /* ── E. Warning Callout ── */
  .body :global(.callout-warn) {
    border-left: 2px solid #D4622B;
    padding: 0.75rem 1rem;
    margin: 1.5rem 0;
  }
  .body :global(.callout-warn-label) {
    font-size: 0.75rem;
    font-weight: 700;
    color: #D4622B;
    margin-bottom: 0.25rem;
  }
  .body :global(.callout-warn-body) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: #555;
  }

  /* ── Blockquote (일반) ── */
  .body :global(blockquote) {
    background: #faf7f1;
    border-left: 3px solid #D4622B;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 8px 8px 0;
    font-size: 0.9rem;
    color: #555;
  }

  /* ── F. Legal Citation Pill ── */
  .body :global(.law-pill) {
    display: inline;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.75rem;
    background: #f7f3ea;
    color: var(--dark-brown);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    text-decoration: none;
  }
  .body :global(.law-pill:hover) {
    background: #EAE4D8;
    opacity: 1;
  }

  /* ── Sidebar ── */
  .sidebar {
    width: 240px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 80px;
    align-self: flex-start;
  }
  .sidebar-search {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #eae4d8;
    padding: 1.25rem;
  }
  .search-input-wrap {
    display: flex;
    gap: 0;
  }
  .search-input {
    flex: 1;
    min-width: 0;
    border: 1.5px solid #ddd6c9;
    border-right: none;
    border-radius: 8px 0 0 8px;
    padding: 0.5rem 0.65rem;
    font-size: 0.8rem;
    font-family: 'Pretendard', sans-serif;
    background: #faf7f2;
    color: var(--dark-brown);
    outline: none;
  }
  .search-input:focus {
    border-color: #D4622B;
  }
  .search-btn {
    background: var(--dark-brown);
    border: none;
    border-radius: 0 8px 8px 0;
    padding: 0 0.6rem;
    color: var(--cream);
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .sidebar-taxinfo {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #eae4d8;
    padding: 1.25rem;
  }
  .si-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .si-table th {
    background: #f0eae0;
    color: var(--dark-brown);
    font-weight: 700;
    padding: 0.35rem 0.5rem;
    text-align: left;
    white-space: nowrap;
  }
  .si-table td {
    padding: 0.3rem 0.5rem;
    border-top: 1px solid #eae4d8;
    white-space: nowrap;
  }
  .si-sub {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--dark-brown);
    margin-bottom: 0.35rem;
  }
  .si-note {
    font-size: 0.7rem;
    color: #999;
    margin-bottom: 0.75rem;
  }
  .si-footer {
    border-top: 1px solid #eae4d8;
    padding-top: 0.6rem;
  }
  .si-footer p {
    font-size: 0.7rem;
    color: #777;
    line-height: 1.6;
  }
  .sidebar-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #D4622B;
    margin-bottom: 0.75rem;
  }
  .sidebar-links {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #eae4d8;
    padding: 1.25rem;
  }
  .sidebar-links ul {
    list-style: none;
  }
  .sidebar-links li {
    border-top: 1px solid #f0ebe3;
    padding: 0.6rem 0;
  }
  .sidebar-links li:first-child {
    border-top: none;
    padding-top: 0;
  }
  .sidebar-links li:last-child {
    padding-bottom: 0;
  }
  .sidebar-links a {
    font-size: 0.85rem;
    line-height: 1.5;
    display: block;
    color: #D4622B;
    font-weight: 600;
    transition: opacity 0.15s;
  }
  .sidebar-links a:hover {
    opacity: 0.75;
  }
  .sidebar-cta {
    background: var(--dark-brown);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .cta-label {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 0.75rem;
  }
  .cta-btn {
    display: inline-block;
    background: #D4622B;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1.25rem;
    border-radius: 8px;
    transition: opacity 0.2s;
  }
  .cta-btn:hover { opacity: 0.85; }

  /* ── Related Posts ── */
  .related-posts {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .related-posts-inner {
    border-top: 1px solid #EAE4D8;
    padding: 2rem 0 0.5rem;
  }
  .related-posts-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #D4622B;
    margin-bottom: 1rem;
  }
  .related-posts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .related-posts-list li {
    border-top: 1px solid #f0ebe3;
  }
  .related-posts-list li:first-child {
    border-top: none;
  }
  .related-posts-list a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.75rem 0;
    transition: color 0.15s;
  }
  .related-posts-list a:hover {
    color: #D4622B;
  }
  .rp-cat {
    font-size: 0.7rem;
    font-weight: 700;
    color: #b5a894;
    flex-shrink: 0;
    letter-spacing: 0.04em;
  }
  .rp-title {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* ── G. Post Footer — Dark CTA Strip ── */
  .post-footer {
    background-color: #2C2117;
    background-image:
      linear-gradient(rgba(245,240,232,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245,240,232,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    padding: 2.5rem 1.5rem;
    margin-top: 3rem;
  }
  .post-footer-inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  .pf-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .pf-cta-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 1.0625rem;
    font-weight: 800;
    color: #F5F0E8;
    margin-bottom: 0.25rem;
  }
  .pf-cta-desc {
    font-size: 0.8125rem;
    color: #b5a894;
    line-height: 1.6;
  }
  .pf-cta-btn {
    display: inline-block;
    background: #D4622B;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    white-space: nowrap;
