<script>
  // Wrap tables in scrollable container
  document.querySelectorAll('.body table').forEach((table) => {
    const wrap = document.createElement('div');
    wrap.className = 'table-wrap';
    table.parentNode!.insertBefore(wrap, table);
    wrap.appendChild(table);
  });

  // E. Transform > [!주의] blockquotes into callout-warn
  document.querySelectorAll('.body blockquote').forEach((bq) => {
    const text = bq.textContent?.trim() ?? '';
    if (text.startsWith('[!주의]')) {
      const content = text.replace(/^\[!주의\]\s*/, '');
      bq.outerHTML = `<div class="callout-warn"><p class="callout-warn-label">주의</p><p class="callout-warn-body">${content}</p></div>`;
    }
  });

  // D. Table footnote — if next sibling p starts with "기준:"
  document.querySelectorAll('.body .table-wrap').forEach((wrap) => {
    const next = wrap.nextElementSibling;
    if (next && next.tagName === 'P' && next.textContent?.trim().startsWith('기준:')) {
      next.classList.add('table-footnote');
    }
  });
</script>
