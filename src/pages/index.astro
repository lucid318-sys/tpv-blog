      <div class="section-wide">
        <div class="about-recent-layout">
          <div class="about-side">
            <p class="about-name">세무사 허혜주</p>
            <p class="about-label">더프라이빗 세무회계</p>
            <p class="about-desc">부동산 세금 실무 9년+, 비대면 전문</p>
            <a href="/about" class="about-link">자세히 보기 &rarr;</a>
          </div>
          <div class="recent-side">
            <h2>최근 세금 이야기</h2>
            <div class="compact-posts">
              {posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="compact-post">
                  <span class={`cat-badge ${post.data.category}`}>{categoryLabels[post.data.category] ?? post.data.category}</span>
                  <span class="compact-title">{post.data.title}</span>
                  <time><span class="date-full">{fmtDate(post.data.date)}</span><span class="date-short">{fmtDateShort(post.data.date)}</span></time>
