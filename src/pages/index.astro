            </ul>
          </div>
        </div>
        <p class="product-note">신고 대행은 별도 견적</p>
        <div class="product-cta">
          <a href="https://pf.kakao.com/_dcihX/chat" target="_blank" rel="noopener" class="btn btn-primary">카카오톡으로 상담 신청</a>
        </div>
      </div>
    </section>

    <!-- ⑥ 세무사 소개 + 최근 글 -->
