        </div>
      </div>
    </section>

    <!-- ⑤ 상담 상품 -->
    <section class="consult-products">
      <div class="section-inner">
        <h2>상담 안내</h2>
        <p class="product-intro">필요한 만큼만, 부담 없이.</p>
        <div class="product-grid">
          <div class="product-card">
            <div class="product-header">
              <strong class="product-name">절세노트</strong>
              <span class="product-price">88,000원</span>
            </div>
            <p class="product-desc">핵심만 짚어드리는 세금 요약 노트</p>
            <ul class="product-list">
              <li>간단한 세금 궁금증</li>
              <li>예상 세액 + 절세 포인트 정리</li>
            </ul>
          </div>
          <div class="product-card">
            <div class="product-header">
              <strong class="product-name">프라이빗 리포트</strong>
              <span class="product-price">220,000원</span>
            </div>
