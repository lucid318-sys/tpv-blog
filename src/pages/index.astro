---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { regulationPeriods } from "../data/regulatedAreaHistory";

const posts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const fmtDate = (d: string) => {
  const [y, m, dd] = d.split('-');
  return `${y}.${+m}.${+dd}`;
};
const fmtDateShort = (d: string) => {
  const [, m, dd] = d.split('-');
  return `${+m}.${+dd}`;
};

const categoryLabels: Record<string, string> = {
  chwideuk: "취득세",
  yangdo: "양도세",
  sangsok: "상속세",
  jeungyeo: "증여세",
  etc: "기타",
};

// 규제지역 위젯용 경량 데이터: sido+region 유니크 목록 + 현재 지정 여부
const seen = new Set<string>();
const areaList: { sido: string; region: string; active: boolean }[] = [];
for (const p of regulationPeriods) {
  const key = `${p.sido}|${p.region}`;
  if (seen.has(key)) {
    if (!p.lifted) {
      const existing = areaList.find(a => a.sido === p.sido && a.region === p.region);
      if (existing) existing.active = true;
    }
    continue;
  }
  seen.add(key);
  areaList.push({ sido: p.sido, region: p.region, active: !p.lifted });
}
const areaDataJson = JSON.stringify(areaList);
---
<Base title="" description="양도·증여·상속·취득세 전문 비대면 세무 상담. 세무사 허혜주 더프라이빗 세무회계.">
  <!-- JSON-LD: LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "더프라이빗 세무회계",
    "alternateName": "더프라이빗택스",
