---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { regulationPeriods } from "../data/regulatedAreaHistory";

const posts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const labels: Record<string, string> = { chwideuk: "취득세", yangdo: "양도소득세", sangsok: "상속세", jeungyeo: "증여세", etc: "기타" };
const dateText = (date: string) => date.split("-").join(".");
const areaMap = new Map<string, { sido: string; region: string; active: boolean }>();
for (const period of regulationPeriods) {
  const key = `${period.sido}|${period.region}`;
  const item = areaMap.get(key);
  if (item) { if (!period.lifted) item.active = true; }
  else areaMap.set(key, { sido: period.sido, region: period.region, active: !period.lifted });
}
const areaDataJson = JSON.stringify([...areaMap.values()]);
---

<Base title="" description="양도·증여·상속·취득세 전문 비대면 세무 상담. 세무사 허혜주 더프라이빗 세무회계.">
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "LocalBusiness", name: "더프라이빗 세무회계", alternateName: "더프라이빗택스", url: "https://theprivatetax.com", founder: { "@type": "Person", name: "허혜주" } })} />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <span class="star s1" aria-hidden="true">✦</span><span class="star s2" aria-hidden="true">✦</span><span class="star s3" aria-hidden="true">✦</span>
      <div class="hero-inner">
        <p class="eyebrow">THE PRIVATE TAX · 세무사 허혜주</p>
        <h1 id="hero-title"><span class="rotator" aria-live="polite"><span class="is-active">팔기 전,</span><span>사기 전,</span><span>물려주기 전,</span></span><br class="mobile-line-break" />숫자부터<br />함께 확인합니다.</h1>
        <p class="hero-copy">부동산 세금은 시점과 순서에 따라 달라집니다.<br />지금 필요한 판단부터 차분히 정리합니다.</p>
      </div>
      <div class="hero-meta"><span>부동산 세금 실무 9년+</span><span>양도 · 증여 · 상속 전문</span><span>비대면 상담 가능</span></div>
    </section>

    <section class="questions" aria-labelledby="questions-title"><div class="wide">
      <p class="label">거래 전에 확인할 질문</p><h2 id="questions-title">먼저, 이 중 하나를<br />확인해 보세요.</h2>
      <div class="question-list">
        <a href="/category/yangdo/" class="question"><i>01</i><span><strong>지금 집을 팔아도 될까요?</strong><small>보유 기간 · 주택 수 · 비과세 요건</small></span><b>→</b></a>
        <a href="/category/chwideuk/" class="question"><i>02</i><span><strong>사기 전, 세금은 얼마나 들까요?</strong><small>취득세 · 주택 수 · 자금 계획</small></span><b>→</b></a>
        <a href="/category/jeungyeo/" class="question"><i>03</i><span><strong>증여와 상속 중 무엇이 나을까요?</strong><small>가족 구성 · 시점 · 재산의 규모</small></span><b>→</b></a>
        <a href="/resources/regulated-areas/" class="question"><i>04</i><span><strong>우리 지역은 규제지역인가요?</strong><small>지정 여부 · 해제 이력 · 적용 기간</small></span><b>→</b></a>
      </div>
    </div></section>

    <section class="evidence" aria-label="직접 확인하는 정보"><div class="wide evidence-grid">
      <div class="lookup"><p class="label">직접 확인할 수 있는 정보</p><h2>우리 지역,<br />규제지역인가요?</h2><p>지정 여부와 해제 이력을<br />주소 단위로 바로 확인합니다.</p>
        <div class="lookup-input"><input id="reg-input" type="search" placeholder="시·군·구 이름을 입력하세요" autocomplete="off" aria-label="규제지역 검색" /><button id="reg-submit" type="button">조회 →</button></div><div id="reg-results" class="reg-results" aria-live="polite"></div>
      </div>
      <div class="stories"><p class="label">판단 전에 읽어볼 글</p><h2>지금 많이 확인하는 기준</h2><div class="story-list">
        {posts.map((post) => <a href={`/blog/${post.id}/`} class="story"><time datetime={post.data.date}>{dateText(post.data.date)}</time><span><small>{labels[post.data.category] ?? post.data.category}</small>{post.data.title}</span><b>→</b></a>)}
      </div><a href="/category/yangdo/" class="all-stories">세금 이야기 모두 보기 →</a></div>
    </div></section>

    <section class="consult" aria-labelledby="consult-title"><div class="wide consult-grid"><h2 id="consult-title">한 가지 기준으로<br />정리되지 않는 거래라면.</h2><div><p>주택 수, 보유 기간, 가족 구성, 거래 순서를<br />함께 놓고 판단합니다.</p><nav><a href="/about/">세무사 허혜주 소개 →</a><a href="/consult/">상담 안내 보기 →</a></nav></div></div></section>
  </main>
</Base>

<style>
  .wide{width:min(100% - 3rem,980px);margin:0 auto}.hero{position:relative;min-height:610px;overflow:hidden;padding:108px max(11vw,calc((100vw - 980px)/2)) 88px;color:#f8f2e9;background-color:var(--dark-brown);background-image:linear-gradient(rgba(248,242,233,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(248,242,233,.04) 1px,transparent 1px);background-size:56px 56px}.hero-inner{position:relative;z-index:1}.eyebrow,.label{margin:0;color:#d8956c;font-size:.78rem;font-weight:500;letter-spacing:-.02em}.hero h1,.questions h2,.evidence h2,.consult h2{font-family:var(--font-bookk);font-weight:300;letter-spacing:-.085em}.hero h1{margin:1.6rem 0 1.8rem;font-size:clamp(3.35rem,6.35vw,5.5rem);line-height:1.06}.rotator{display:inline-grid;min-width:3.7em}.rotator span{grid-area:1/1;opacity:0;transform:translateY(7px);transition:opacity .42s ease,transform .42s ease}.rotator .is-active{opacity:1;transform:translateY(0)}.mobile-line-break{display:none}.hero-copy{margin:0;color:#e5d7c8;font-size:1rem;line-height:1.8;letter-spacing:-.045em}.hero-meta{position:absolute;right:max(11vw,calc((100vw - 980px)/2));bottom:0;left:max(11vw,calc((100vw - 980px)/2));display:flex;gap:2rem;padding:1.35rem 0;border-top:1px solid rgba(248,242,233,.26);color:#ecd9c8;font-size:.82rem}.star{position:absolute;color:#e7a271;font-size:.7rem;opacity:.35;animation:twinkle 4.2s ease-in-out infinite}.s1{top:22%;right:22%}.s2{top:59%;right:7%;font-size:.5rem;animation-delay:1.4s}.s3{top:40%;left:6%;font-size:.42rem;animation-delay:2.6s}.questions{padding:7.2rem 0 8rem;background:var(--cream)}.questions h2{margin:1rem 0 3.1rem;color:var(--dark-brown);font-size:clamp(2.35rem,4vw,3.45rem);line-height:1.22}.question-list{border-top:1px solid var(--line-dark)}.question{display:grid;grid-template-columns:70px minmax(0,1fr) 32px;gap:1rem;align-items:center;min-height:100px;padding:1.1rem 0;border-bottom:1px solid var(--line-light);color:var(--dark-brown);text-decoration:none}.question i{color:#a68c78;font-size:.78rem;font-style:normal}.question strong{display:block;margin-bottom:.35rem;font-size:1.22rem;font-weight:500;letter-spacing:-.06em}.question small{display:block;color:#806b5a;font-size:.85rem;letter-spacing:-.04em}.question b,.story b{color:var(--terracotta);font-size:1.5rem;font-weight:400;transition:transform .18s ease}.question:hover strong{text-decoration:underline;text-decoration-color:var(--terracotta);text-decoration-thickness:1px;text-underline-offset:7px}.question:hover b,.story:hover b{transform:translateX(5px)}.evidence{padding:7rem 0;background:var(--sand)}.evidence-grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(3rem,8vw,7rem)}.lookup{padding-right:clamp(3rem,8vw,7rem);border-right:1px solid #bba991}.evidence h2{margin:1rem 0 1.2rem;font-size:1.7rem;line-height:1.35}.lookup>p:not(.label){margin:0 0 2.8rem;color:#705c4c;font-size:.9rem;line-height:1.75}.lookup-input{display:flex;align-items:center;border-bottom:1px solid var(--line-dark)}.lookup-input input{width:100%;min-width:0;padding:.75rem 0;border:0;outline:0;background:transparent;color:var(--dark-brown);font:inherit;font-size:.9rem}.lookup-input input::placeholder{color:#95816f}.lookup-input button{padding:.75rem 0 .75rem 1.1rem;border:0;background:transparent;color:var(--dark-brown);cursor:pointer;font-size:.85rem;white-space:nowrap}.reg-results{min-height:1.4rem}.reg-result{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 0;border-bottom:1px solid #cbbba7;color:var(--dark-brown);font-size:.82rem;text-decoration:none}.reg-result em{color:var(--terracotta);font-style:normal;white-space:nowrap}.stories h2{margin:1rem 0 1.7rem;font-family:'SUIT Variable','Pretendard',sans-serif;font-size:1.35rem;font-weight:500;letter-spacing:-.065em}.story-list{border-top:1px solid var(--line-dark)}.story{display:grid;grid-template-columns:88px minmax(0,1fr) 24px;gap:.9rem;align-items:center;padding:1.25rem 0;border-bottom:1px solid #cbbba7;color:var(--dark-brown);text-decoration:none}.story time{color:#9a6749;font-size:.75rem}.story span{font-size:.95rem;letter-spacing:-.05em}.story small{display:block;margin-bottom:.2rem;color:#806b5a;font-size:.72rem}.story b{font-size:1.2rem}.all-stories{display:inline-block;margin-top:1.75rem;color:#934d2c;font-size:.85rem;text-decoration:none}.consult{padding:7.7rem 0 6.8rem;color:#f8f2e9;background:var(--dark-brown)}.consult-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.95fr);gap:5rem;align-items:end}.consult h2{margin:0;font-size:clamp(2.65rem,4.6vw,4.1rem);line-height:1.13}.consult-grid>div>p{margin:0 0 1.8rem;color:#e2d3c5;font-size:.95rem;line-height:1.8}.consult nav{display:flex;gap:1.6rem;flex-wrap:wrap}.consult nav a{padding-bottom:.3rem;border-bottom:1px solid #e2a071;color:#f2d5be;font-size:.85rem;text-decoration:none}@keyframes twinkle{0%,100%{opacity:.15;transform:scale(.85)}50%{opacity:.6;transform:scale(1.1)}}@media(max-width:720px){.hero{min-height:570px;padding:90px 1.5rem 86px;background-size:44px 44px}.hero h1{font-size:3.05rem}.mobile-line-break{display:inline}.hero-copy{font-size:.88rem}.hero-meta{right:1.5rem;left:1.5rem;gap:.8rem 1.2rem;padding:1.1rem 0;font-size:.7rem;flex-wrap:wrap}.s1{right:13%}.s3{display:none}.questions,.evidence,.consult{padding:4.8rem 0}.questions h2{margin-bottom:2.1rem;font-size:2.35rem}.question{grid-template-columns:33px minmax(0,1fr) 20px;gap:.65rem;min-height:103px}.question strong{font-size:1.05rem;line-height:1.4}.question small{font-size:.75rem;line-height:1.5}.question b{font-size:1.2rem}.evidence-grid,.consult-grid{grid-template-columns:1fr;gap:3.6rem}.lookup{padding:0 0 3.6rem;border-right:0;border-bottom:1px solid #bba991}.story{grid-template-columns:76px minmax(0,1fr) 16px;gap:.6rem}.story span{font-size:.85rem}.consult h2{font-size:2.75rem}.consult-grid{gap:2.3rem}}@media(prefers-reduced-motion:reduce){.star{animation:none}.rotator span{transition:none}}
</style>

<style>
  @media (min-width: 721px) {
    .hero h1 { font-size: clamp(2.55rem, 4.1vw, 3.85rem); line-height: 1.12; }
    .consult-grid { grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr); gap: 3rem; }
    .consult h2 { font-size: clamp(2.55rem, 3.8vw, 3.5rem); word-break: keep-all; }
  }
</style>

<script define:vars={{ areaDataJson }}>
  const input = document.getElementById('reg-input');
  const results = document.getElementById('reg-results');
  const submit = document.getElementById('reg-submit');
  const regions = areaDataJson;
  const openSearch = (query) => { if (query.trim()) window.location.href = `/resources/regulated-areas/?q=${encodeURIComponent(query.trim())}`; };
  const renderMatches = (query) => {
    if (!results) return; results.replaceChildren(); if (!query.trim()) return;
    regions.filter((region) => `${region.sido} ${region.region}`.includes(query.trim())).slice(0, 4).forEach((region) => {
      const link = document.createElement('a'); link.className = 'reg-result'; link.href = `/resources/regulated-areas/?q=${encodeURIComponent(region.region)}`;
      const name = document.createElement('span'); name.textContent = `${region.sido} ${region.region}`;
      const state = document.createElement('em'); state.textContent = region.active ? '현재 지정' : '이력 확인'; link.append(name, state); results.append(link);
    });
  };
  input?.addEventListener('input', () => renderMatches(input.value));
  input?.addEventListener('keydown', (event) => { if (event.key === 'Enter') { event.preventDefault(); openSearch(input.value); } });
  submit?.addEventListener('click', () => openSearch(input?.value ?? ''));
  const words = Array.from(document.querySelectorAll('.rotator span')); let current = 0;
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && words.length > 1) window.setInterval(() => { words[current].classList.remove('is-active'); current = (current + 1) % words.length; words[current].classList.add('is-active'); }, 3600);
</script>
