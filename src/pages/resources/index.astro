---
import Base from "../../layouts/Base.astro";
import { REFERENCE_DATE } from "../../data/regulatedAreas";

const pressReleases = [
  {
    date: "2026-09-17",
    title: "토지거래허가구역 내 실거주 유예, ’27년 12월 31일까지 연장·확대",
    summary: "실거주 유예 신청 기한 연장과 임대차 갱신계약 인정 확대 발표. 자료상 2026년 10월 1일 시행 예정.",
    file: "/files/press-releases/2026-09-17-land-transaction-residency.pdf",
  },
  {
    date: "2026-05-12",
    title: "세입자 있는 주택 전체로 토지거래허가구역 실거주 유예 확대",
    summary: "실거주 유예 대상을 세입자 있는 주택 전체로 확대하는 방안 발표. 적용 요건과 관련 질의응답 수록.",
    file: "/files/press-releases/2026-05-12-land-transaction-residency.pdf",
  },
];

const taxReforms = [
  {
    title: "2026년 세제개편안 자료 모음",
    agency: "재정경제부",
    note: "8월 3일 발표 이후 일부 내용이 수정되었습니다. 9월 1일 국무회의 의결 보도자료의 수정사항을 함께 확인하세요.",
    files: [
      { title: "국무회의 의결 보도자료 · 수정사항", date: "2026-09-01", file: "2026-09-01-tax-reform-cabinet.pdf" },
      { title: "세제개편안 상세본", date: "2026-08-03", file: "2026-08-03-tax-reform-details.pdf" },
      { title: "세제개편안 문답자료", date: "2026-08-03", file: "2026-08-03-tax-reform-qa.pdf" },
    ],
  },
  {
    title: "2026년 지방세제 개편안 자료 모음",
    agency: "행정안전부",
    note: "지방세제 개편안과 주요 내용에 대한 문답자료를 함께 제공합니다.",
    files: [
      { title: "지방세제 개편안", date: "2026-08-26", file: "2026-08-26-local-tax-reform.pdf" },
      { title: "지방세제 개편안 문답자료", date: "2026-08-26", file: "2026-08-26-local-tax-reform-qa.pdf" },
    ],
  },
];
---
<Base title="자료실">
  <main class="main">
    <h1 class="page-title">자료실</h1>

    <section id="policy" class="section">
      <h2 class="section-title">정책·보도자료</h2>
      <a href="/resources/regulated-areas/" class="card">
        <div>
          <h3 class="card-title">규제지역 지정현황</h3>
          <p class="card-desc">조정대상지역·투기과열지구 현황 및 지정 연혁</p>
        </div>
        <span class="card-badge">{REFERENCE_DATE} 기준</span>
      </a>
      <h3 class="group-title" id="press-releases">보도자료</h3>
      <div class="press-list">
        {pressReleases.map((release) => (
          <article class="press-card">
            <p class="press-meta">보도자료 · 국토교통부 · <time datetime={release.date}>{release.date.replaceAll("-", ".")}</time></p>
            <h4 class="card-title">{release.title}</h4>
            <p class="card-desc">{release.summary}</p>
            <div class="press-actions">
              <a href={release.file} target="_blank" rel="noopener noreferrer" aria-label={`${release.title} PDF 원문 보기 (새 탭)`}>PDF 원문 보기 ↗</a>
              <a href={release.file} download aria-label={`${release.title} PDF 다운로드`}>다운로드</a>
            </div>
          </article>
        ))}
      </div>
      <h3 class="group-title" id="tax-reforms">세제개편안</h3>
      <p class="group-note">발표 당시의 개편안 자료로, 이후 심의·입법 과정에서 내용이 달라질 수 있습니다.</p>
      <div class="press-list">
        {taxReforms.map((reform) => (
          <article class="press-card">
            <p class="press-meta">세제개편안 · {reform.agency}</p>
            <h4 class="card-title">{reform.title}</h4>
            <p class="card-desc">{reform.note}</p>
            <ul class="attachment-list">
              {reform.files.map((file) => (
                <li>
                  <p class="attachment-title">{file.title}</p>
                  <time class="press-meta" datetime={file.date}>{file.date.replaceAll("-", ".")}</time>
                  <div class="press-actions">
                    <a href={`/files/press-releases/${file.file}`} target="_blank" rel="noopener noreferrer" aria-label={`${file.title} PDF 원문 보기 (새 탭)`}>PDF 원문 보기 ↗</a>
                    <a href={`/files/press-releases/${file.file}`} download aria-label={`${file.title} PDF 다운로드`}>다운로드</a>
                  </div>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="forms" class="section">
      <h2 class="section-title">서식</h2>
      <p class="placeholder">준비 중입니다.</p>
    </section>

    <section id="guide" class="section">
      <h2 class="section-title">이렇게 준비하세요</h2>
      <a href="/category/guide/" class="card">
        <div>
          <h3 class="card-title">절차 가이드 모음</h3>
          <p class="card-desc">홈택스 화면 안내, 상담 준비물, 서류 발급 방법 등</p>
        </div>
        <span class="card-badge">바로가기</span>
      </a>
    </section>
  </main>
</Base>

<style>
  .main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .page-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  .section {
    margin-bottom: 2.5rem;
  }
  .section-title {
    font-size: 1rem;
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e8e2d6;
  }
  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }
  .card:hover {
    box-shadow: 0 4px 20px rgba(44,33,23,0.1);
  }
  .press-list {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .group-title {
    margin-top: 2rem;
    margin-bottom: 0.65rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--dark-brown);
  }
  .group-note {
    font-size: 0.8rem;
    line-height: 1.7;
    color: #777;
  }
  .attachment-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .attachment-list li {
    border-top: 1px solid #e8e2d6;
    padding-top: 1rem;
  }
  .attachment-list li + li {
    margin-top: 1rem;
  }
  .attachment-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.6;
    margin-bottom: 0.25rem;
  }
  .attachment-list .press-actions {
    margin-top: 0.5rem;
  }
  .press-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
  }
  .press-meta {
    color: #777;
    font-size: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .press-card .card-title {
    line-height: 1.5;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .press-card .card-desc {
    line-height: 1.7;
  }
  .press-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .press-actions a {
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .card-desc {
    font-size: 0.85rem;
    color: #777;
  }
  .card-badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--terracotta);
    color: #fff;
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
    white-space: nowrap;
  }
  .placeholder {
    color: #999;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
