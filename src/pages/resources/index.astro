---
import Base from "../../layouts/Base.astro";
import { REFERENCE_DATE } from "../../data/regulatedAreas";

const pressReleases = [
  {
    date: "2026-09-17",
    title: "토지거래허가구역 내 실거주 유예, ’27년 12월 31일까지 연장·확대",
    summary: "실거주 유예 신청 기한 연장과 임대차 갱신계약 인정 확대 발표. 자료상 2026년 10월 1일 시행 예정.",
    file: "/files/press-releases/2026-09-17-land-transaction-residency.pdf",
  },
  {
    date: "2026-05-12",
    title: "세입자 있는 주택 전체로 토지거래허가구역 실거주 유예 확대",
    summary: "실거주 유예 대상을 세입자 있는 주택 전체로 확대하는 방안 발표. 적용 요건과 관련 질의응답 수록.",
    file: "/files/press-releases/2026-05-12-land-transaction-residency.pdf",
  },
];

const taxReforms = [
  {
    title: "2026년 세제개편안 자료 모음",
    agency: "재정경제부",
    note: "8월 3일 발표 이후 일부 내용이 수정되었습니다. 9월 1일 국무회의 의결 보도자료의 수정사항을 함께 확인하세요.",
    files: [
      { title: "국무회의 의결 보도자료 · 수정사항", date: "2026-09-01", file: "2026-09-01-tax-reform-cabinet.pdf" },
      { title: "세제개편안 상세본", date: "2026-08-03", file: "2026-08-03-tax-reform-details.pdf" },
      { title: "세제개편안 문답자료", date: "2026-08-03", file: "2026-08-03-tax-reform-qa.pdf" },
    ],
  },
  {
    title: "2026년 지방세제 개편안 자료 모음",
    agency: "행정안전부",
    note: "지방세제 개편안과 주요 내용에 대한 문답자료를 함께 제공합니다.",
    files: [
      { title: "지방세제 개편안", date: "2026-08-26", file: "2026-08-26-local-tax-reform.pdf" },
      { title: "지방세제 개편안 문답자료", date: "2026-08-26", file: "2026-08-26-local-tax-reform-qa.pdf" },
    ],
  },
];
---
<Base title="자료실">
  <main class="main">
    <header class="page-header">
      <p class="eyebrow">더프라이빗택스 자료실</p>
      <h1 class="page-title">필요한 자료를 찾아보세요</h1>
      <p class="page-intro">지역별 규제 현황부터 정책 원문, 신고 준비 안내까지.</p>
    </header>
    <nav class="resource-nav" aria-label="자료 분류">
      <a href="#areas" class="resource-category"><span class="category-label">규제지역 지정현황</span><span class="category-desc">지역별 현황 · 지정 연혁</span></a>
      <a href="#press-releases" class="resource-category"><span class="category-label">보도자료</span><span class="category-desc">정책 발표 · PDF 원문</span></a>
      <a href="#tax-reforms" class="resource-category"><span class="category-label">세제개편안</span><span class="category-desc">개편안 · 문답자료</span></a>
      <a href="#forms" class="resource-category"><span class="category-label">서식 <small>준비 중</small></span><span class="category-desc">신청 · 신고 서식</span></a>
      <a href="#guide" class="resource-category"><span class="category-label">이렇게 준비하세요</span><span class="category-desc">홈택스 · 서류 · 상담 준비</span></a>
    </nav>

    <section id="areas" class="section" data-resource-panel aria-labelledby="areas-title">
      <h2 id="areas-title" class="section-title">규제지역 지정현황</h2>
      <a href="/resources/regulated-areas/" class="card">
        <div>
          <h3 class="card-title">규제지역 지정현황</h3>
          <p class="card-desc">조정대상지역·투기과열지구 현황 및 지정 연혁</p>
        </div>
        <span class="card-badge">{REFERENCE_DATE} 기준</span>
      </a>
      </section>
    <section id="press-releases" class="section" data-resource-panel aria-labelledby="press-title">
      <h2 class="section-title" id="press-title">보도자료</h2>
      <p class="group-note">주요 부동산 정책의 발표 내용과 원문을 확인하세요.</p>
      <div class="press-list">
        {pressReleases.map((release) => (
          <article class="press-card">
            <p class="press-meta">보도자료 · 국토교통부 · <time datetime={release.date}>{release.date.replaceAll("-", ".")}</time></p>
            <h3 class="card-title">{release.title}</h3>
            <p class="card-desc">{release.summary}</p>
            <div class="press-actions">
              <a href={release.file} target="_blank" rel="noopener noreferrer" aria-label={`${release.title} PDF 원문 보기 (새 탭)`}>PDF 원문 보기 ↗</a>
              <a href={release.file} download aria-label={`${release.title} PDF 다운로드`}>다운로드</a>
            </div>
          </article>
        ))}
      </div>
      </section>
    <section id="tax-reforms" class="section" data-resource-panel aria-labelledby="reforms-title">
      <h2 class="section-title" id="reforms-title">세제개편안</h2>
      <p class="group-note">발표 당시의 개편안 자료로, 이후 심의·입법 과정에서 내용이 달라질 수 있습니다.</p>
      <div class="press-list">
        {taxReforms.map((reform) => (
          <article class="press-card">
            <p class="press-meta">세제개편안 · {reform.agency}</p>
            <h3 class="card-title">{reform.title}</h3>
            <p class="card-desc">{reform.note}</p>
            <ul class="attachment-list">
              {reform.files.map((file) => (
                <li>
                  <p class="attachment-title">{file.title}</p>
                  <time class="press-meta" datetime={file.date}>{file.date.replaceAll("-", ".")}</time>
                  <div class="press-actions">
                    <a href={`/files/press-releases/${file.file}`} target="_blank" rel="noopener noreferrer" aria-label={`${file.title} PDF 원문 보기 (새 탭)`}>PDF 원문 보기 ↗</a>
                    <a href={`/files/press-releases/${file.file}`} download aria-label={`${file.title} PDF 다운로드`}>다운로드</a>
                  </div>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="forms" class="section" data-resource-panel aria-labelledby="forms-title">
      <h2 id="forms-title" class="section-title">서식</h2>
      <div class="empty-state"><p class="empty-title">서식을 준비하고 있습니다</p><p>신청·신고에 필요한 서식을 이곳에 모아 안내하겠습니다.</p></div>
    </section>

    <section id="guide" class="section" data-resource-panel aria-labelledby="guide-title">
      <h2 id="guide-title" class="section-title">이렇게 준비하세요</h2>
      <a href="/category/guide/" class="card">
        <div>
          <h3 class="card-title">절차 가이드 모음</h3>
          <p class="card-desc">홈택스 화면 안내, 상담 준비물, 서류 발급 방법 등</p>
        </div>
        <span class="card-badge">바로가기</span>
      </a>
    </section>
  </main>
</Base>

<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-resource-panel]'));
  const categories = Array.from(document.querySelectorAll<HTMLAnchorElement>('.resource-category'));
  function selectCategory() {
    const requested = window.location.hash.slice(1);
    const resolved = requested === 'policy' ? 'press-releases' : requested;
    const selected = panels.some((panel) => panel.id === resolved) ? resolved : 'areas';
    panels.forEach((panel) => { panel.hidden = panel.id !== selected; });
    categories.forEach((link) => {
      if (link.hash === `#${selected}`) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }
  categories.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
      selectCategory();
    });
  });
  window.addEventListener('hashchange', selectCategory);
  window.addEventListener('popstate', selectCategory);
  selectCategory();
</script>

<style>
  .main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .page-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  .section {
    margin-bottom: 2.5rem;
  }
  .section-title {
    font-size: 1rem;
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e8e2d6;
  }
  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }
  .card:hover {
    box-shadow: 0 4px 20px rgba(44,33,23,0.1);
  }
  .press-list {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .group-title {
    margin-top: 2rem;
    margin-bottom: 0.65rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--dark-brown);
  }
  .group-note {
    font-size: 0.8rem;
    line-height: 1.7;
    color: #777;
  }
  .attachment-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .attachment-list li {
    border-top: 1px solid #e8e2d6;
    padding-top: 1rem;
  }
  .attachment-list li + li {
    margin-top: 1rem;
  }
  .attachment-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.6;
    margin-bottom: 0.25rem;
  }
  .attachment-list .press-actions {
    margin-top: 0.5rem;
  }
  .press-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
  }
  .press-meta {
    color: #777;
    font-size: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .press-card .card-title {
    line-height: 1.5;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .press-card .card-desc {
    line-height: 1.7;
  }
  .press-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .press-actions a {
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card-title {
    font-family: 'SUIT Variable', 'Pretendard', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .card-desc {
    font-size: 0.85rem;
    color: #777;
  }
  .card-badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--terracotta);
    color: #fff;
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
    white-space: nowrap;
  }
  .placeholder {
    color: #999;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .page-header { margin: 1rem 0 2rem; }
  .eyebrow { font-size: .75rem; letter-spacing: .08em; color: #86664f; margin-bottom: .65rem; }
  .page-title { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: .65rem; letter-spacing: -.04em; }
  .page-intro { color: #71675d; font-size: .95rem; word-break: keep-all; }
  .resource-nav { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .6rem; margin-bottom: 2.5rem; }
  .resource-category { border: 1px solid var(--line-light); background: var(--paper); padding: 1.15rem .9rem; border-radius: 10px; transition: background .15s, border-color .15s; }
  .resource-category:hover { border-color: var(--dark-brown); }
  .resource-category[aria-current] { background: var(--dark-brown); color: #fffdf9; border-color: var(--dark-brown); }
  .category-label { display: block; font-size: .9rem; font-weight: 700; word-break: keep-all; }
  .category-desc { display: block; margin-top: .55rem; font-size: .7rem; color: #71675d; word-break: keep-all; }
  .resource-category[aria-current] .category-desc { color: #e5d6c5; }
  .category-label small { display: inline-block; font-size: .6rem; font-weight: 500; margin-left: .15rem; opacity: .8; }
  .resource-category:focus-visible, .section a:focus-visible { outline: 3px solid var(--terracotta); outline-offset: 4px; }
  .section { scroll-margin-top: 100px; }
  .section[hidden] { display: none; }
  .section-title { font-size: 1.2rem; color: var(--dark-brown); letter-spacing: -.02em; border-bottom: 2px solid var(--line-light); padding-bottom: .8rem; }
  .press-list { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  .press-card, .card { border: 1px solid #e8e2d6; }
  .empty-state { text-align: center; padding: 3rem 1.5rem; border: 1px dashed var(--line-light); border-radius: 12px; color: #71675d; font-size: .9rem; }
  .empty-title { color: var(--dark-brown); font-weight: 700; margin-bottom: .5rem; }
  @media (max-width: 800px) {
    .resource-nav { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .main { padding: 1.5rem 1rem 3rem; }
    .resource-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; margin-bottom: 2rem; }
    .resource-category { padding: .9rem; }
    .resource-category:last-child { grid-column: 1 / -1; }
    .category-desc { margin-top: .3rem; }
    .press-list { grid-template-columns: 1fr; }
    .press-card { padding: 1.25rem; }
  }
</style>
